class Solution:
    def shiftGrid(self, grid, k):
        m, n = len(grid), len(grid[0])
        t = m * n
        k %= t
        res = [[0] * n for _ in range(m)]

        for i in range(m):
            row = grid[i]
            for j in range(n):
                idx = (i * n + j + k) % t
                res[idx // n][idx % n] = row[j]

        return res
